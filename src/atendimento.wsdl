<?xml version="1.0" encoding="UTF-8"?>
<definitions name="AtendimentoService"
    xmlns="http://schemas.xmlsoap.org/wsdl/"
    xmlns:tns="http://example.com/atendimento/wsdl"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    targetNamespace="http://example.com/atendimento/wsdl">

    <types>
        <xsd:schema targetNamespace="http://example.com/atendimento/wsdl" elementFormDefault="qualified">
            
            <xsd:element name="gerarTokenRequest">
                <xsd:complexType><xsd:sequence/></xsd:complexType>
            </xsd:element>
            <xsd:element name="tokenResponse">
                <xsd:complexType>
                    <xsd:sequence><xsd:element name="token" type="xsd:string"/></xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <xsd:element name="registrarSolicitacaoRequest">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="idUsuario" type="xsd:int"/>
                        <xsd:element name="nomeUsuario" type="xsd:string"/>
                        <xsd:element name="descricao" type="xsd:string"/>
                        <xsd:element name="categoria" type="xsd:string"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="registrarSolicitacaoResponse">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="protocolo" type="xsd:int"/>
                        <xsd:element name="idUsuario" type="xsd:int"/>
                        <xsd:element name="nomeUsuario" type="xsd:string"/>
                        <xsd:element name="descricao" type="xsd:string"/>
                        <xsd:element name="categoria" type="xsd:string"/>
                        <xsd:element name="status" type="xsd:string"/>
                        <xsd:element name="dataCriacao" type="xsd:string"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <xsd:element name="consultarStatusRequest">
                <xsd:complexType>
                    <xsd:sequence><xsd:element name="protocolo" type="xsd:int"/></xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="statusResponse">
                <xsd:complexType>
                    <xsd:sequence><xsd:element name="status" type="xsd:string"/></xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <xsd:element name="listarSolicitacoesPorUsuarioRequest">
                <xsd:complexType>
                    <xsd:sequence><xsd:element name="idUsuario" type="xsd:int"/></xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="listarSolicitacoesPorUsuarioResponse">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="solicitacoes" maxOccurs="unbounded" minOccurs="0">
                            <xsd:complexType>
                                <xsd:sequence>
                                    <xsd:element name="protocolo" type="xsd:int"/>
                                    <xsd:element name="idUsuario" type="xsd:int"/>
                                    <xsd:element name="nomeUsuario" type="xsd:string"/>
                                    <xsd:element name="descricao" type="xsd:string"/>
                                    <xsd:element name="categoria" type="xsd:string"/>
                                    <xsd:element name="status" type="xsd:string"/>
                                    <xsd:element name="dataCriacao" type="xsd:string"/>
                                </xsd:sequence>
                            </xsd:complexType>
                        </xsd:element>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <xsd:element name="atualizarStatusRequest">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="protocolo" type="xsd:int"/>
                        <xsd:element name="status" type="xsd:string"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <xsd:element name="removerSolicitacaoRequest">
                <xsd:complexType>
                    <xsd:sequence><xsd:element name="protocolo" type="xsd:int"/></xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="resultadoResponse">
                <xsd:complexType>
                    <xsd:sequence><xsd:element name="resultado" type="xsd:string"/></xsd:sequence>
                </xsd:complexType>
            </xsd:element>

        </xsd:schema>
    </types>

    <message name="gerarTokenRequest"><part name="parameters" element="tns:gerarTokenRequest"/></message>
    <message name="gerarTokenResponse"><part name="parameters" element="tns:tokenResponse"/></message>

    <message name="registrarSolicitacaoRequest"><part name="parameters" element="tns:registrarSolicitacaoRequest"/></message>
    <message name="registrarSolicitacaoResponse"><part name="parameters" element="tns:registrarSolicitacaoResponse"/></message>

    <message name="consultarStatusRequest"><part name="parameters" element="tns:consultarStatusRequest"/></message>
    <message name="consultarStatusResponse"><part name="parameters" element="tns:statusResponse"/></message>

    <message name="listarSolicitacoesPorUsuarioRequest"><part name="parameters" element="tns:listarSolicitacoesPorUsuarioRequest"/></message>
    <message name="listarSolicitacoesPorUsuarioResponse"><part name="parameters" element="tns:listarSolicitacoesPorUsuarioResponse"/></message>

    <message name="atualizarStatusRequest"><part name="parameters" element="tns:atualizarStatusRequest"/></message>
    <message name="atualizarStatusResponse"><part name="parameters" element="tns:statusResponse"/></message>

    <message name="removerSolicitacaoRequest"><part name="parameters" element="tns:removerSolicitacaoRequest"/></message>
    <message name="removerSolicitacaoResponse"><part name="parameters" element="tns:resultadoResponse"/></message>

    <portType name="AtendimentoPortType">
        <operation name="gerarToken">
            <input message="tns:gerarTokenRequest"/>
            <output message="tns:gerarTokenResponse"/>
        </operation>
        <operation name="registrarSolicitacao">
            <input message="tns:registrarSolicitacaoRequest"/>
            <output message="tns:registrarSolicitacaoResponse"/>
        </operation>
        <operation name="consultarStatus">
            <input message="tns:consultarStatusRequest"/>
            <output message="tns:consultarStatusResponse"/>
        </operation>
        <operation name="listarSolicitacoesPorUsuario">
            <input message="tns:listarSolicitacoesPorUsuarioRequest"/>
            <output message="tns:listarSolicitacoesPorUsuarioResponse"/>
        </operation>
        <operation name="atualizarStatus">
            <input message="tns:atualizarStatusRequest"/>
            <output message="tns:atualizarStatusResponse"/>
        </operation>
        <operation name="removerSolicitacao">
            <input message="tns:removerSolicitacaoRequest"/>
            <output message="tns:removerSolicitacaoResponse"/>
        </operation>
    </portType>

    <binding name="AtendimentoBinding" type="tns:AtendimentoPortType">
        <soap:binding transport="http://schemas.xmlsoap.org/soap/http" style="document"/>
        <operation name="gerarToken">
            <soap:operation soapAction="gerarToken"/>
            <input><soap:body use="literal"/></input>
            <output><soap:body use="literal"/></output>
        </operation>
        <operation name="registrarSolicitacao">
            <soap:operation soapAction="registrarSolicitacao"/>
            <input><soap:body use="literal"/></input>
            <output><soap:body use="literal"/></output>
        </operation>
        <operation name="consultarStatus">
            <soap:operation soapAction="consultarStatus"/>
            <input><soap:body use="literal"/></input>
            <output><soap:body use="literal"/></output>
        </operation>
        <operation name="listarSolicitacoesPorUsuario">
            <soap:operation soapAction="listarSolicitacoesPorUsuario"/>
            <input><soap:body use="literal"/></input>
            <output><soap:body use="literal"/></output>
        </operation>
        <operation name="atualizarStatus">
            <soap:operation soapAction="atualizarStatus"/>
            <input><soap:body use="literal"/></input>
            <output><soap:body use="literal"/></output>
        </operation>
        <operation name="removerSolicitacao">
            <soap:operation soapAction="removerSolicitacao"/>
            <input><soap:body use="literal"/></input>
            <output><soap:body use="literal"/></output>
        </operation>
    </binding>

    <service name="AtendimentoService">
        <port name="AtendimentoPort" binding="tns:AtendimentoBinding">
            <soap:address location="http://localhost:8000/wsdl"/>
        </port>
    </service>
</definitions>